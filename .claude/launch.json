{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shweetbrew-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--config",
        "vite.config.ts",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "shweetbrew-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--config",
        "vite.config.ts",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "shweetbrew-standin",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/supabase-standin/dev-against-standin.mjs"
      ],
      "port": 3002
    }
  ]
}
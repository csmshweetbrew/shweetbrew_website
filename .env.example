# Shweet Brew: copy to `.env` (git-ignored) and fill in.
# Supabase dashboard → Project Settings → API Keys / JWT Keys.

# Public: built into the website, safe for visitors to see
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secret: never prefix with VITE_, never commit. For admin scripts / the admin app's server side only.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS=

# ---------------------------------------------------------------------------
# Shweet Brew: environment variables
#
# Copy this file to `.env` in the same folder (the project root) and fill it in.
# `.env` is git-ignored, so never put real keys in this example file.
#
# Where to find the values: Supabase dashboard → your project → Project Settings
#   → API (URL + keys) and → Database (connection string).
# ---------------------------------------------------------------------------

# --- Browser (public) ------------------------------------------------------
# Anything starting with VITE_ is built into the website and visible to every
# visitor. Only put the PUBLIC anon / publishable key here. The database is
# protected by Row Level Security (see supabase/migrations).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# "anon public" key (legacy JWT, starts with eyJ...) or the new
# "publishable" key (starts with sb_publishable_...). Either works.
VITE_SUPABASE_ANON_KEY=

# While the admin app isn't in use yet, every website order is ALSO opened in
# WhatsApp (with its SB-#### reference) so none are missed. Set to false once
# you track orders in the admin app.
VITE_ORDER_WHATSAPP_COPY=true

# --- Server / admin only (SECRET) ------------------------------------------
# Never prefix these with VITE_ and never put them in Netlify's public build
# for the website. They bypass Row Level Security. Use them only in scripts,
# server functions or the future admin back office.

# "service_role" key (legacy) or the new "secret" key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# Project reference: the "abcdefghijklmnop" part of the project URL.
# Used by the Supabase CLI (`npx supabase link --project-ref ...`).
SUPABASE_PROJECT_REF=

# Postgres connection string (Database → Connection string → URI, "Session
# pooler"). Used by `npx supabase db push --db-url ...` to apply migrations.
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Optional ---------------------------------------------------------------
# Umami analytics (already supported by main.tsx; leave empty to disable)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
